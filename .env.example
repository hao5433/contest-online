# Postgres (used by docker-compose's `db` service)
POSTGRES_USER=exam_user
POSTGRES_PASSWORD=exam_password
POSTGRES_DB=exam_system

# Backend
# Inside docker-compose, host is `db`; running the backend locally without
# Docker, point this at localhost instead (see README).
DATABASE_URL=postgresql+psycopg2://exam_user:exam_password@db:5432/exam_system
REDIS_URL=redis://redis:6379/0
# REQUIRED: generate your own before running anywhere but a throwaway local
# clone - `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Leaving the literal placeholder below in effect means anyone who's read
# this file can forge a valid JWT for any user/role (the app logs a warning
# at startup if it detects this). Never commit your real value here.
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
